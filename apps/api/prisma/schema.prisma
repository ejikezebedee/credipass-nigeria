generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CONSUMER
  SME_OWNER
  BUSINESS_USER
  COOPERATIVE_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum AuditEvent {
  USER_REGISTERED
  AUTHENTICATION_SUCCEEDED
  AUTHENTICATION_FAILED
  TOKEN_REFRESHED
  SESSION_LOGGED_OUT
  CONSENT_GRANTED
  CONSENT_REVOKED
  IDENTITY_VIEWED
  RISK_EVALUATION_REQUESTED
  REPORT_REQUESTED
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum RiskRecommendation {
  REVIEW_RECOMMENDED
  ADDITIONAL_INFORMATION_RECOMMENDED
  MANUAL_ASSESSMENT_RECOMMENDED
}

enum ReportRequestStatus {
  PENDING
  READY
  FAILED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  displayName String
  role Role
  createdAt DateTime @default(now())
  riskEvaluations RiskEvaluation[]
  passports CreditPassport[]
  reportRequests ReportRequest[]
  sessions AuthSession[]
  auditLogs AuditLog[]
}

model AuthSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastRotatedAt DateTime @default(now())
  revokedAt DateTime?
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  event AuditEvent
  correlationId String
  metadata Json
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([event, createdAt])
}

model RiskEvaluation {
  id String @id @default(cuid())
  subjectId String
  subject User @relation(fields: [subjectId], references: [id])
  recommendation RiskRecommendation
  rationaleCode String
  createdAt DateTime @default(now())
}

model CreditPassport {
  id String @id @default(cuid())
  subjectId String
  subject User @relation(fields: [subjectId], references: [id])
  consentStatus ConsentStatus
  maskedIdentityReference String
  createdAt DateTime @default(now())
}

model ReportRequest {
  id String @id @default(cuid())
  requesterId String
  requester User @relation(fields: [requesterId], references: [id])
  status ReportRequestStatus @default(PENDING)
  purposeCode String
  createdAt DateTime @default(now())
}
